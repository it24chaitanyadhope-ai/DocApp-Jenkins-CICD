package com.example.Config;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.CommandLineRunner;
import org.springframework.stereotype.Component;

@Component
public class DataInitializer implements CommandLineRunner {

    @Autowired
    private com.example.Repository.UserRepository userRepository;

    @Override
    public void run(String... args) throws Exception {
        System.out.println("=== DataInitializer started ===");
        
        // Add sample users if none exist
        if (userRepository.count() == 0) {
            // Create User 1 - Patient
            com.example.DocApp.Model.User user1 = new com.example.DocApp.Model.User();
            user1.setName("John Patient");
            user1.setEmail("patient@demo.com");
            user1.setPassword("patient123");  // ✅ FIXED
            user1.setRole("PATIENT");
            userRepository.save(user1);
            
            // Create User 2 - Doctor
            com.example.DocApp.Model.User user2 = new com.example.DocApp.Model.User();
            user2.setName("Dr. Sarah Smith");
            user2.setEmail("doctor@demo.com");
            user2.setPassword("doctor123");   // ✅ FIXED
            user2.setRole("DOCTOR");
            userRepository.save(user2);
            
            // Create User 3 - Admin
            com.example.DocApp.Model.User user3 = new com.example.DocApp.Model.User();
            user3.setName("System Admin");
            user3.setEmail("admin@demo.com");
            user3.setPassword("admin123");    // ✅ FIXED
            user3.setRole("ADMIN");
            userRepository.save(user3);
            
            System.out.println("=== 3 sample users created in MongoDB ===");
        }
        
        System.out.println("Total users in database: " + userRepository.count());
    }
}